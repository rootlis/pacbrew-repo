pkgbase=ps5-payload-zlib
pkgname=(
	ps5-payload-zlib
	ps5-payload-libminizip
)
pkgver=1.4
pkgrel=3
pkgdesc='Deflate compression method library'
arch=('any')
url='http://www.zlib.net/'
license=(Zlib)
options=(!strip libtool staticlibs)
source=("https://github.com/madler/zlib/releases/download/v$pkgver/zlib-$pkgver.tar.gz")
sha256sums=('02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584')
groups=('ps5-payload-dev')
makedepends=('ps5-payload-sdk')
makedepends+=('clang' 'llvm' 'lld')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi
    cd zlib-$pkgver/contrib/minizip
    autoreconf -fiv
    # NOTE: We are not running autoreconf for the top-level project,
    # because `configure` is a custom script.
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd zlib-$pkgver

    ./configure --prefix="${PREFIX}" --static
    ${MAKE}

    cd contrib/minizip
    ./configure --prefix="${PREFIX}" --host=x86_64 --enable-static=yes
    ${MAKE}
}

package_ps5-payload-zlib() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd zlib-$pkgver

    ${MAKE} install DESTDIR="${pkgdir}/${DESTDIR}"

    ${PS5_CROSS_FIX_ROOT} "${pkgdir}/${DESTDIR}/${PREFIX}"
}

package_ps5-payload-libminizip() {
    pkgdesc='Mini zip and unzip based on zlib'

    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd zlib-$pkgver/contrib/minizip

    ${MAKE} install DESTDIR="${pkgdir}/${DESTDIR}"

    ${PS5_CROSS_FIX_ROOT} "${pkgdir}/${DESTDIR}/${PREFIX}"
}
